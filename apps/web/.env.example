# v0.1 runs with no backend at all — every value here is optional.

# Bypasses auth and starts MSW. Never true against real user data.
NEXT_PUBLIC_DEMO_MODE=false

# Unset in v0.1. When unset the engine uses LoopbackRoomClient and shows an
# "offline" badge rather than failing to connect.
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:2567

NEXT_PUBLIC_DEFAULT_SCENERY=kamakura-bay
